PORT=5000
MONGO_URI=mongodb://localhost:27017/healthvault
JWT_SECRET=your_jwt_secret_key_here
NODE_ENV=development

# Gemini API Configuration for Document Embeddings & Intelligence
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Pinecone Vector Database Configuration
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=healthvault

# OCR Configuration
OCR_MIN_EXTRACTED_CHARACTERS=50

# SMTP Email Configuration for Email OTP Verification
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="HealthVault Security <no-reply@healthvault.local>"

